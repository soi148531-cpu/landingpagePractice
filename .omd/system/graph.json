{
  "$schema": "https://oh-my-design.kr/schema/design-system-graph-v2.schema.json",
  "components_states": {
    "components": [
      {
        "anatomy": [
          "아이콘(선택)",
          "글자"
        ],
        "id": "primary-action",
        "interaction": {
          "kind": "interactive",
          "state_applicability": {
            "default": {
              "applicability": "applicable"
            },
            "disabled": {
              "applicability": "not-applicable",
              "reason": "모든 버튼이 항상 사용 가능한 링크다"
            },
            "error": {
              "applicability": "not-applicable",
              "reason": "입력 폼이 없다"
            },
            "focus-visible": {
              "applicability": "applicable"
            },
            "hover": {
              "applicability": "applicable"
            },
            "loading": {
              "applicability": "not-applicable",
              "reason": "페이지 안에서 처리하는 작업 없이 전화·메일 앱이나 지도로 이동만 한다"
            },
            "success": {
              "applicability": "not-applicable",
              "reason": "입력 폼이 없다"
            }
          }
        },
        "semantics": "견적 요청·전화·이메일처럼 페이지를 벗어나는 링크 버튼",
        "states": [
          "default",
          "hover",
          "focus-visible"
        ],
        "token_refs": [
          "color.action.primary",
          "color.action.primary-hover",
          "color.text.on-dark",
          "radius.control",
          "size.control-height"
        ],
        "variants": [
          "채움",
          "외곽선"
        ]
      },
      {
        "anatomy": [
          "머리글 행",
          "설비명",
          "제조사",
          "보유 수량",
          "가공 범위"
        ],
        "id": "equipment-table",
        "interaction": {
          "kind": "non-interactive",
          "reason": "읽기 전용 표다. 행에 마우스를 올리면 배경만 옅게 바뀐다"
        },
        "semantics": "보유 설비 목록 표. 좁은 화면에서는 표 전체가 옆으로 밀려서 보인다",
        "states": [
          "default",
          "hover"
        ],
        "token_refs": [
          "color.surface.dark",
          "color.text.on-dark-muted",
          "color.border.subtle",
          "radius.none"
        ]
      },
      {
        "anatomy": [
          "로고",
          "메뉴",
          "전화 버튼",
          "모바일 메뉴 버튼"
        ],
        "id": "site-header",
        "interaction": {
          "kind": "interactive",
          "state_applicability": {
            "default": {
              "applicability": "applicable"
            },
            "disabled": {
              "applicability": "not-applicable",
              "reason": "비활성 메뉴 항목이 없다"
            },
            "error": {
              "applicability": "not-applicable",
              "reason": "입력이 없다"
            },
            "focus-visible": {
              "applicability": "applicable"
            },
            "hover": {
              "applicability": "applicable"
            },
            "loading": {
              "applicability": "not-applicable",
              "reason": "같은 페이지 안에서 위치만 이동한다"
            },
            "success": {
              "applicability": "not-applicable",
              "reason": "입력이 없다"
            }
          }
        },
        "semantics": "화면 위에 고정된 메뉴. 모바일에서는 메뉴가 접힌다",
        "states": [
          "default",
          "hover",
          "focus-visible"
        ],
        "token_refs": [
          "color.surface.base",
          "color.border.subtle",
          "color.text.strong"
        ]
      },
      {
        "anatomy": [
          "어두운 바탕",
          "용도 라벨"
        ],
        "id": "photo-slot",
        "interaction": {
          "kind": "non-interactive",
          "reason": "표시 전용이다"
        },
        "semantics": "고객 사진을 받기 전까지 사진 위치와 용도를 보여주는 빈 자리",
        "states": [
          "default"
        ],
        "token_refs": [
          "color.surface.dark",
          "color.text.on-dark-muted",
          "radius.none"
        ]
      }
    ],
    "rules": [
      "키보드로 이동할 때 모든 링크와 버튼에 눈에 보이는 포커스 테두리를 둔다",
      "버튼과 메뉴의 누를 수 있는 영역은 최소 44px 높이를 지킨다"
    ]
  },
  "content_locales": {
    "locales": [
      {
        "locale": "ko",
        "rules": [
          "존댓말 '-습니다'체를 쓴다",
          "가공 범위 단위는 mm로 통일한다"
        ],
        "status": "supported"
      }
    ],
    "terminology": {
      "CMM": "3차원 측정기(CMM)",
      "MCT": "머시닝센터(MCT)",
      "견적 요청": "도면 보내고 견적 받기"
    },
    "voice": [
      "짧고 사실 중심",
      "현장 용어를 그대로 쓴다",
      "숫자와 단위를 명확히 쓴다"
    ]
  },
  "experience": {
    "avoid": [
      "둥근 카드와 아이콘 타일의 반복 나열",
      "그라데이션 장식과 과장된 마케팅 문구",
      "검증되지 않은 거래처 실명이나 인증 주장"
    ],
    "design_direction": [
      "정밀하고 단단함",
      "정보 우선",
      "절제된 강조"
    ],
    "primary_tasks": [
      "보유 설비와 가공 범위를 확인한다",
      "품질 인증과 협력사 등록 이력을 확인한다",
      "전화하거나 이메일로 도면을 보내 견적을 요청한다",
      "공장 위치를 지도에서 찾는다"
    ],
    "principles": [
      "행동 버튼은 한눈에 읽혀야 한다: 강조색은 견적 요청처럼 실제 행동에만 쓴다",
      "숫자와 표가 주인공이다: 설비 표와 수치는 장식보다 먼저 읽힌다",
      "사진은 실제 현장만 보여준다: 연습작(가상 회사)은 AI 생성 사진을 쓰고, 실제 고객 작업은 고객이 제공한 사진으로 바꾼다"
    ],
    "summary": "구매 담당자와 설계 엔지니어가 휴대폰에서도 설비·인증·연락처를 빠르게 확인하고 도면을 보낼 수 있는, 단단하고 정보 중심적인 B2B 회사 소개 페이지. 대한정밀은 연습용 가상 회사다."
  },
  "foundations": {
    "contrast_pairs": [
      {
        "background": "color.surface.base",
        "foreground": "color.text.strong",
        "minimum_ratio": 4.5
      },
      {
        "background": "color.surface.base",
        "foreground": "color.text.muted",
        "minimum_ratio": 4.5
      },
      {
        "background": "color.surface.muted",
        "foreground": "color.text.muted",
        "minimum_ratio": 4.5
      },
      {
        "background": "color.action.primary",
        "foreground": "color.text.on-dark",
        "minimum_ratio": 4.5
      },
      {
        "background": "color.action.primary-hover",
        "foreground": "color.text.on-dark",
        "minimum_ratio": 4.5
      },
      {
        "background": "color.surface.dark",
        "foreground": "color.text.on-dark",
        "minimum_ratio": 4.5
      },
      {
        "background": "color.surface.dark",
        "foreground": "color.text.on-dark-muted",
        "minimum_ratio": 4.5
      },
      {
        "background": "color.surface.dark",
        "foreground": "color.accent.on-dark",
        "minimum_ratio": 4.5
      },
      {
        "background": "color.brand.logo",
        "foreground": "color.text.strong",
        "minimum_ratio": 4.5
      }
    ],
    "reduced_motion": true,
    "rules": [
      "color.action.primary는 견적 요청·전화·이메일 같은 실제 행동에만 쓰고 배경 장식에 쓰지 않는다",
      "한 화면에 강조색 버튼은 최대 2개까지 둔다",
      "카드·표·사진 자리는 radius.none, 버튼만 radius.control을 쓴다",
      "그림자 대신 color.border.subtle 테두리로 구역을 나눈다",
      "그라데이션은 사진 자리 표시 외에는 쓰지 않는다"
    ],
    "tokens": {
      "color.accent.on-dark": {
        "$description": "어두운 배경 위 작은 강조 (대비 8.02:1)",
        "$type": "color",
        "$value": "#ff8a4c"
      },
      "color.action.primary": {
        "$description": "견적 요청 등 주 행동 버튼 배경 (흰 글씨 대비 5.18:1)",
        "$type": "color",
        "$value": "#c2410c"
      },
      "color.action.primary-hover": {
        "$description": "주 행동 버튼에 마우스를 올렸을 때 (흰 글씨 대비 7.31:1)",
        "$type": "color",
        "$value": "#9a3412"
      },
      "color.border.subtle": {
        "$description": "표와 카드의 테두리",
        "$type": "color",
        "$value": "#d6dbe6"
      },
      "color.brand.logo": {
        "$description": "로고 판 색. 글자는 color.text.strong (대비 5.69:1)",
        "$type": "color",
        "$value": "#ea7036"
      },
      "color.surface.base": {
        "$description": "기본 배경",
        "$type": "color",
        "$value": "#ffffff"
      },
      "color.surface.dark": {
        "$description": "첫 화면과 품질 구역의 짙은 강철색 배경",
        "$type": "color",
        "$value": "#0b1220"
      },
      "color.surface.muted": {
        "$description": "구역을 나누는 연회색 배경",
        "$type": "color",
        "$value": "#eef1f6"
      },
      "color.text.muted": {
        "$description": "보조 설명 글자색",
        "$type": "color",
        "$value": "#3e4f73"
      },
      "color.text.on-dark": {
        "$description": "어두운 배경 위 글자색",
        "$type": "color",
        "$value": "#ffffff"
      },
      "color.text.on-dark-muted": {
        "$description": "어두운 배경 위 보조 글자색",
        "$type": "color",
        "$value": "#b3bccd"
      },
      "color.text.strong": {
        "$description": "본문과 제목의 기본 글자색",
        "$type": "color",
        "$value": "#111a2b"
      },
      "radius.control": {
