      },
      "space.xs": {
        "$type": "dimension",
        "$value": "8px"
      }
    }
  },
  "governance": {
    "change_policy": [
      "색·간격을 바꾸면 이 문서와 코드를 함께 바꾼다",
      "실제 고객 작업 시 회사 정보와 사진 출처를 다시 확인한다"
    ],
    "priority": [
      "사용자의 직접 지시",
      "저장소의 실제 코드와 내용",
      "이 디자인 시스템",
      "검증된 참고 자료(IBM)"
    ],
    "unknown_policy": "absent-at-smallest-unresolved-boundary"
  },
  "identity": {
    "kind": "project-system",
    "name": "대한정밀",
    "scope": "금속 정밀가공 공장(가상의 연습용 회사) 회사 소개 원페이지 웹사이트"
  },
  "layout_platforms": {
    "minimum_width_px": 320,
    "platforms": [
      {
        "id": "web",
        "rules": [
          "휴대폰 화면을 먼저 확인한다",
          "전화번호는 누르면 바로 전화가 걸리는 링크로 만든다"
        ]
      }
    ],
    "reflow_zoom_percent": 200,
    "rules": [
      "본문 최대 폭은 1152px, 좌우 여백은 모바일 16px·태블릿 이상 24px",
      "구역 순서: 첫 화면 → 회사소개 → 사업분야 → 보유설비 → 품질·인증 → 진행순서 → 거래분야 → 연혁 → 문의·위치",
      "좁은 화면에서는 여러 칸이 한 칸으로 쌓이고, 설비 표만 옆으로 밀어서 본다",
      "페이지 전체가 옆으로 밀리는 가로 스크롤은 없어야 한다"
    ]
  },
  "projection": {
    "locale": "en",
    "path": "DESIGN.md",
    "sha256": "8574fc0fb76e7d119eba903e1eef06dcbf716d0b02c1877313fc039b28a77b3a"
  },
  "schema_version": "2.0.0",
  "typography_assets": {
    "assets": [
